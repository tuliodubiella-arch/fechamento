# Configure estas variáveis no serviço de hospedagem. O aplicativo não lê este arquivo automaticamente.
NODE_ENV=production
HOST=0.0.0.0
PORT=4273
DATA_DIR=/data
COOKIE_SECURE=true
# Defina um código secreto aleatório com pelo menos 32 caracteres para criar o primeiro administrador.
# Não envie o valor real ao GitHub. Configure-o apenas no serviço de hospedagem.
SETUP_TOKEN=
